# Supabase — Frontier Property Management (project ref tzevnimcpjzmwreuuoxv)
# Publishable key is safe in the browser; it is restricted by row level security.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-only. Bypasses row level security entirely.
# Never prefix this NEXT_PUBLIC_, never commit it, never send it to the browser.
SUPABASE_SERVICE_ROLE_KEY=
